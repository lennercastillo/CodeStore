@model IEnumerable<Aplicacion.DTOs.DTOSAbono>

@{
    ViewData["Title"] = "Pagos y Abonos";
    var totalRecaudado = Model.Where(a => a.Estado == "Activo").Sum(a => a.MontoAbono);
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Créditos & Cobranzas</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-coin me-2 text-primary"></i>Pagos y Abonos Recibidos
            </h2>
            <div class="text-secondary mt-1">Historial de recibos de caja, amortizaciones de cuotas y cobranzas</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-plus me-1 fs-3"></i> Registrar Abono
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-receipt me-2 text-primary"></i>Historial de Recibos
        </h3>
        <span class="badge bg-success-lt fs-4">Total Recaudado: C$ @totalRecaudado.ToString("N2")</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaAbonos" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="w-1">Recibo</th>
                        <th>Fecha</th>
                        <th>Cuota</th>
                        <th>Método</th>
                        <th class="text-end">A Mora</th>
                        <th class="text-end">A Capital</th>
                        <th class="text-end">Total Abonado</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Recibo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark-lt font-monospace">@item.NumeroRecibo</span></td>
                            <td>
                                <div class="text-dark fw-medium">@item.FechaAbono.ToString("dd/MM/yyyy")</div>
                                <div class="text-secondary small">@item.FechaAbono.ToString("hh:mm tt")</div>
                            </td>
                            <td><span class="badge bg-azure-lt">Cuota #@item.IdCuota</span></td>
                            <td>@item.MetodoPago</td>
                            <td class="text-end text-danger">C$ @item.MontoAplicadoMora.ToString("N2")</td>
                            <td class="text-end text-dark">C$ @item.MontoAplicadoCapital.ToString("N2")</td>
                            <td class="text-end fw-bold text-success">C$ @item.MontoAbono.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge @(item.Estado == "Activo" ? "bg-success-lt" : "bg-danger-lt")">@item.Estado</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Recibo" asp-route-id="@item.IdAbono" class="btn btn-sm btn-outline-primary">
                                    <i class="ti ti-printer"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaAbonos').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                order: [],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>Swal.fire({ icon: 'success', title: '¡Abono Registrado!', text: '@Html.Raw(TempData["Success"])', timer: 3000, showConfirmButton: false });</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>Swal.fire({ icon: 'error', title: 'Atención', text: '@Html.Raw(TempData["Error"])' });</text>
            }
        });
    </script>
}

