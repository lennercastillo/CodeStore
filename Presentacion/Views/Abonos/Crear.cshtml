@{
    ViewData["Title"] = "Registrar Abono";
    var cuotas = ViewBag.CuotasPendientes as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int? idSel = ViewBag.IdCuotaSeleccionada as int?;
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Créditos & Cobranzas</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-coin me-2 text-primary"></i>Registrar Abono a Cuota
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Volver a Abonos
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="card-header bg-white py-3 border-bottom">
                <h3 class="card-title text-dark fw-bold m-0">
                    <i class="ti ti-cash me-2 text-primary"></i>Datos del Pago
                </h3>
            </div>

            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
                }

                <div class="mb-3">
                    <label class="form-label required">Cuota Pendiente</label>
                    <select name="idCuota" id="selectCuota" class="form-select" required>
                        <option value="">-- Seleccione la cuota a abonar --</option>
                        @foreach (var c in cuotas)
                        {
                            <option value="@c.IdCuota" data-saldo="@(((decimal)c.SaldoCuota).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))" selected="@(idSel == (int)c.IdCuota)">@c.Texto</option>
                        }
                    </select>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label required">Monto a Abonar ($)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" name="montoAbono" id="inputMontoAbono" step="0.01" min="0.01" value="@(ViewBag.MontoAbono != null ? ((decimal)ViewBag.MontoAbono).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" class="form-control form-control-lg fw-bold text-success" required />
                        </div>
                        <div class="text-secondary small mt-1" id="saldoInfo">Seleccione una cuota para ver su saldo máximo.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label required">Método de Pago</label>
                        <select name="metodoPago" class="form-select form-select-lg" required>
                            <option value="Efectivo" selected="@(ViewBag.MetodoPago == "Efectivo" || ViewBag.MetodoPago == null)">Efectivo</option>
                            <option value="Tarjeta" selected="@(ViewBag.MetodoPago == "Tarjeta")">Tarjeta</option>
                            <option value="Transferencia" selected="@(ViewBag.MetodoPago == "Transferencia")">Transferencia</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Observaciones</label>
                    <textarea name="observaciones" rows="2" class="form-control" placeholder="Referencia de transferencia, notas del pago...">@ViewBag.Observaciones</textarea>
                </div>
            </div>

            <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-link link-secondary">Cancelar</a>
                <button type="submit" class="btn btn-success d-inline-flex align-items-center">
                    <i class="ti ti-check me-2 fs-3"></i> Confirmar y Emitir Recibo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function actualizarSaldo() {
            const opt = $('#selectCuota option:selected');
            const saldo = parseFloat(opt.data('saldo'));
            if (!isNaN(saldo) && saldo > 0) {
                $('#inputMontoAbono').attr('max', saldo.toFixed(2));
                if (!$('#inputMontoAbono').val()) {
                    $('#inputMontoAbono').val(saldo.toFixed(2));
                }
                $('#saldoInfo').html(`Saldo pendiente de esta cuota: <strong class="text-primary">$ ${saldo.toFixed(2)}</strong>`);
            } else {
                $('#saldoInfo').text('Seleccione una cuota para ver su saldo máximo.');
            }
        }

        $(document).ready(function () {
            $('#selectCuota').on('change', function () {
                const saldo = parseFloat($('#selectCuota option:selected').data('saldo'));
                if (!isNaN(saldo)) $('#inputMontoAbono').val(saldo.toFixed(2));
                actualizarSaldo();
            });
            actualizarSaldo();
        });
    </script>
}

