<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title>@ViewData["Title"] - CodeStore</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tabler Core CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/css/tabler.min.css" />
    <!-- Tabler Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/tabler-icons.min.css" />
    <!-- DataTables Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />

    <!-- Custom styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fluid">
    <div class="page">
        <!-- Sidebar Navigation -->
        <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
            <div class="container-fluid">
                <!-- Mobile toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Brand Logo -->
                <h1 class="navbar-brand navbar-brand-autodark">
                    <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none text-reset">
                        <span class="avatar avatar-sm bg-primary text-white me-2">
                            <i class="ti ti-device-laptop fs-2"></i>
                        </span>
                        <span class="fs-2 fw-bold tracking-tight">Code<span class="text-primary">Store</span></span>
                    </a>
                </h1>

                <!-- Sidebar Navigation Menu -->
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-dashboard fs-2"></i>
                                </span>
                                <span class="nav-link-title">Dashboard</span>
                            </a>
                        </li>

                        <!-- Catálogos Header -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#navbar-catalogos" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-category fs-2"></i>
                                </span>
                                <span class="nav-link-title">Catálogos</span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Productos" asp-action="Index">
                                    <i class="ti ti-box me-2"></i> Productos
                                </a>
                                <a class="dropdown-item" asp-controller="Clientes" asp-action="Index">
                                    <i class="ti ti-users me-2"></i> Clientes
                                </a>
                                @if (User.IsInRole("Administrador"))
                                {
                                    <a class="dropdown-item" asp-controller="Proveedores" asp-action="Index">
                                        <i class="ti ti-truck me-2"></i> Proveedores
                                    </a>
                                }
                            </div>
                        </li>

                        @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                        {
                            <!-- Ventas & Facturación -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#navbar-ventas" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-shopping-cart fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Ventas</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Ventas" asp-action="Crear">
                                        <i class="ti ti-cash me-2"></i> Nueva Venta (POS)
                                    </a>
                                    <a class="dropdown-item" asp-controller="Ventas" asp-action="Index">
                                        <i class="ti ti-receipt me-2"></i> Historial de Ventas
                                    </a>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <!-- Compras & Abastecimiento -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#navbar-compras" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-truck-delivery fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Compras</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Compras" asp-action="Crear">
                                        <i class="ti ti-plus me-2"></i> Registrar Compra
                                    </a>
                                    <a class="dropdown-item" asp-controller="Compras" asp-action="Index">
                                        <i class="ti ti-file-invoice me-2"></i> Historial de Compras
                                    </a>
                                </div>
                            </li>

                            <!-- Inventario & Kardex -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Kardex" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-clipboard-list fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Kardex / Stock</span>
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                        {
                            <!-- Créditos & Cobranza -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#navbar-creditos" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-credit-card fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Créditos</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Creditos" asp-action="Index">
                                        <i class="ti ti-list-details me-2"></i> Créditos Activos
                                    </a>
                                    <a class="dropdown-item" asp-controller="Abonos" asp-action="Index">
                                        <i class="ti ti-coin me-2"></i> Pagos y Abonos
                                    </a>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
                        {
                            <!-- Taller Técnico & Garantías -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#navbar-taller" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-tools fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Taller & Garantías</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="OrdenReparacion" asp-action="Index">
                                        <i class="ti ti-cpu me-2"></i> Órdenes de Reparación
                                    </a>
                                    <a class="dropdown-item" asp-controller="ReclamoGarantia" asp-action="Index">
                                        <i class="ti ti-shield-check me-2"></i> Reclamos de Garantía
                                    </a>
                                </div>
                            </li>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <!-- Administración y Seguridad -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#navbar-seguridad" data-bs-toggle="dropdown" data-bs-auto-close="false" role="button" aria-expanded="false">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block">
                                        <i class="ti ti-lock-access fs-2"></i>
                                    </span>
                                    <span class="nav-link-title">Seguridad</span>
                                </a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-controller="Usuarios" asp-action="Index">
                                        <i class="ti ti-user-check me-2"></i> Usuarios
                                    </a>
                                    <a class="dropdown-item" asp-controller="Roles" asp-action="Index">
                                        <i class="ti ti-shield-lock me-2"></i> Roles y Permisos
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Top Header Bar -->
        <header class="navbar navbar-expand-md d-none d-lg-flex d-print-none sticky-top bg-white border-bottom shadow-sm">
            <div class="container-xl">
                <div class="navbar-nav flex-row order-md-last ms-auto align-items-center">
                    <!-- User Profile Dropdown -->
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Menú de usuario">
                            <span class="avatar avatar-sm bg-primary-lt">
                                <i class="ti ti-user fs-2"></i>
                            </span>
                            <div class="d-none d-xl-block ps-2">
                                <div class="fw-semibold">@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Administrador")</div>
                                <div class="mt-1 small text-secondary">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "CodeStore Admin")</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <span class="dropdown-header">Conectado como @User.Identity.Name</span>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    <i class="ti ti-logout me-2"></i> Cerrar Sesión
                                </a>
                            }
                            else
                            {
                                <a class="dropdown-item text-primary" asp-controller="Account" asp-action="Login">
                                    <i class="ti ti-login me-2"></i> Iniciar Sesión
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Content Wrapper -->
        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>

            <!-- Footer -->
            <footer class="footer footer-transparent d-print-none py-3 border-top">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item"><span class="badge bg-blue-lt">.NET 8 MVC</span></li>
                                <li class="list-inline-item"><span class="badge bg-green-lt">Tabler UI</span></li>
                            </ul>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item">
                                    &copy; @DateTime.Now.Year <a href="#" class="link-secondary fw-semibold">CodeStore</a> - Sistema de Gestión Comercial
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0-beta20/dist/js/tabler.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
