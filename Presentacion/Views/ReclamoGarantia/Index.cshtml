@model IEnumerable<Aplicacion.DTOs.DTOSReclamoGarantia>

@{
    ViewData["Title"] = "Reclamos de Garantía";
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Taller Técnico & Garantías</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-shield-check me-2 text-primary"></i>Reclamos de Garantía
            </h2>
            <div class="text-secondary mt-1">Gestión de garantías sobre equipos vendidos, validación de vigencia y resoluciones</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-plus me-1 fs-3"></i> Registrar Reclamo
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">Listado de Garantías</h3>
        <span class="badge bg-blue-lt">@Model.Count() reclamos</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaGarantias" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="w-1">Reclamo</th>
                        <th>Fecha</th>
                        <th>Motivo de Falla</th>
                        <th>Acción Tomada</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark-lt font-monospace">@item.NumeroReclamo</span></td>
                            <td>@item.FechaReclamo.ToString("dd/MM/yyyy")</td>
                            <td>@item.MotivoFalla</td>
                            <td>@(item.AccionTomada ?? "Pendiente de evaluación")</td>
                            <td class="text-center">
                                <span class="badge @(item.EstadoRevision == "Resuelto" ? "bg-success-lt" : item.EstadoRevision == "Rechazado" ? "bg-danger-lt" : "bg-warning-lt")">
                                    @item.EstadoRevision
                                </span>
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Editar" asp-route-id="@item.IdGarantia" class="btn btn-sm btn-outline-primary" title="Resolver / Editar">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-garantia" data-id="@item.IdGarantia" data-num="@item.NumeroReclamo" title="Eliminar">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaGarantias').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                order: [],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>Swal.fire({ icon: 'success', title: '¡Éxito!', text: '@Html.Raw(TempData["Success"])', timer: 3000, showConfirmButton: false });</text>
            }
            @if (TempData["Error"] != null)
            {
                <text>Swal.fire({ icon: 'error', title: 'Atención', text: '@Html.Raw(TempData["Error"])' });</text>
            }

            $(document).on('click', '.btn-eliminar-garantia', function () {
                const id = $(this).data('id');
                const num = $(this).data('num');
                Swal.fire({
                    title: '¿Eliminar reclamo?',
                    text: `¿Deseas eliminar el reclamo "${num}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d63939',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("Eliminar", "ReclamoGarantia")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Eliminado', text: res.message, timer: 2000, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            }
                        });
                    }
                });
            });
        });
    </script>
}

