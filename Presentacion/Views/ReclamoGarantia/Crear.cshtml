@model Aplicacion.DTOs.DTOSReclamoGarantia

@{
    ViewData["Title"] = "Nuevo Reclamo de Garantía";
    var detalles = ViewBag.DetallesVenta as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var series = ViewBag.Series as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var tecnicos = ViewBag.Tecnicos as List<Aplicacion.DTOs.DTOSUsuario> ?? new List<Aplicacion.DTOs.DTOSUsuario>();
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Taller Técnico & Garantías</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-shield-check me-2 text-primary"></i>Registrar Reclamo de Garantía
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="card-header bg-white py-3 border-bottom">
                <h3 class="card-title text-dark fw-bold m-0">Datos del Reclamo</h3>
            </div>

            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="NumeroReclamo" class="form-label required"></label>
                        <input asp-for="NumeroReclamo" class="form-control font-monospace" />
                        <span asp-validation-for="NumeroReclamo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="IdUsuarioTecnico" class="form-label required"></label>
                        <select asp-for="IdUsuarioTecnico" class="form-select">
                            @foreach (var t in tecnicos)
                            {
                                <option value="@t.IdUsuario">@t.Nombres @t.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="IdUsuarioTecnico" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="IdDetalleVenta" class="form-label required">Producto Vendido (Factura)</label>
                        <select asp-for="IdDetalleVenta" id="selectDetalleVenta" class="form-select">
                            <option value="">-- Seleccione el ítem de factura --</option>
                            @foreach (var d in detalles)
                            {
                                <option value="@d.IdDetalleVenta">@d.Texto</option>
                            }
                        </select>
                        <span asp-validation-for="IdDetalleVenta" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="IdSerieVendida" class="form-label">Número de Serie (Opcional)</label>
                        <select asp-for="IdSerieVendida" id="selectSerieVendida" class="form-select">
                            <option value="">-- Sin serie específica --</option>
                            @foreach (var s in series)
                            {
                                <option value="@s.IdSerieVendida" data-detalle="@s.IdDetalleVenta">@s.NumeroSerie</option>
                            }
                        </select>
                        <span asp-validation-for="IdSerieVendida" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="MotivoFalla" class="form-label required"></label>
                        <textarea asp-for="MotivoFalla" rows="3" class="form-control" placeholder="Describa detalladamente la falla presentada por el equipo..."></textarea>
                        <span asp-validation-for="MotivoFalla" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EstadoRevision" class="form-label required"></label>
                        <select asp-for="EstadoRevision" class="form-select">
                            <option value="Recibido">Recibido</option>
                            <option value="En Revision">En Revisión</option>
                            <option value="En Reparacion">En Reparación</option>
                            <option value="Resuelto">Resuelto</option>
                            <option value="Rechazado">Rechazado</option>
                        </select>
                        <span asp-validation-for="EstadoRevision" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AccionTomada" class="form-label"></label>
                        <select asp-for="AccionTomada" class="form-select">
                            <option value="">-- Pendiente --</option>
                            <option value="Reparacion Tecnica">Reparación Técnica</option>
                            <option value="Reemplazo de Equipo">Reemplazo de Equipo</option>
                            <option value="Nota de Credito">Nota de Crédito</option>
                            <option value="No Aplica Garantia">No Aplica Garantía</option>
                        </select>
                        <span asp-validation-for="AccionTomada" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-link link-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-2"></i>Registrar Reclamo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function filtrarSeries() {
            const idDetalle = $('#selectDetalleVenta').val();
            const selSerie = $('#selectSerieVendida');
            selSerie.find('option[data-detalle]').each(function () {
                const coincide = idDetalle && String($(this).data('detalle')) === String(idDetalle);
                $(this).toggle(Boolean(coincide));
            });
            const opcionActual = selSerie.find('option:selected');
            if (opcionActual.data('detalle') && String(opcionActual.data('detalle')) !== String(idDetalle)) {
                selSerie.val('');
            }
        }

        $(document).ready(function () {
            $('#selectDetalleVenta').on('change', filtrarSeries);
            filtrarSeries();
        });
    </script>
}

