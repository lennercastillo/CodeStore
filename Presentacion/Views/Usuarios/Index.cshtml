@model IEnumerable<Aplicacion.DTOs.DTOSUsuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
    var rolesDict = ViewBag.Roles as Dictionary<int, string> ?? new Dictionary<int, string>();
    var total = Model.Count();
    var activos = Model.Count(u => u.Activo);
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-user-check me-2 text-primary"></i>Gestión de Usuarios
            </h2>
            <div class="text-secondary mt-1">Control de cuentas de acceso, asignación de roles y estado de colaboradores</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-user-plus me-1 fs-3"></i> Nuevo Usuario
            </a>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-list me-2 text-primary"></i>Cuentas Registradas
        </h3>
        <span class="badge bg-blue-lt">@activos activos de @total</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaUsuarios" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Correo</th>
                        <th>Rol</th>
                        <th>Teléfono</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var rolNombre = rolesDict.ContainsKey(item.IdRol) ? rolesDict[item.IdRol] : $"Rol #{item.IdRol}";
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm me-2 bg-primary-lt">
                                        <i class="ti ti-user fs-3"></i>
                                    </span>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.Nombres @item.Apellidos</div>
                                        <div class="text-secondary small">ID: #@item.IdUsuario</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-dark"><i class="ti ti-mail me-1 text-secondary"></i>@item.Correo</span>
                            </td>
                            <td>
                                <span class="badge bg-indigo-lt">@rolNombre</span>
                            </td>
                            <td>
                                <span class="text-secondary small">@(string.IsNullOrEmpty(item.Telefono) ? "N/D" : item.Telefono)</span>
                            </td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success-lt">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-lt">Inactivo</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Editar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-usuario" data-id="@item.IdUsuario" data-nombre="@item.Nombres @item.Apellidos" title="Eliminar">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaUsuarios').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                order: [[0, 'asc']],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({ icon: 'success', title: '¡Operación Exitosa!', text: '@Html.Raw(TempData["Success"])', timer: 3000, showConfirmButton: false });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({ icon: 'error', title: 'Atención', text: '@Html.Raw(TempData["Error"])' });
                </text>
            }

            $(document).on('click', '.btn-eliminar-usuario', function () {
                const id = $(this).data('id');
                const nombre = $(this).data('nombre');

                Swal.fire({
                    title: '¿Eliminar usuario?',
                    text: `¿Deseas eliminar la cuenta de "${nombre}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d63939',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Eliminar", "Usuarios")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Eliminado', text: res.message, timer: 2000, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'No se pudo eliminar', text: res.message });
                            }
                        });
                    }
                });
            });
        });
    </script>
}

