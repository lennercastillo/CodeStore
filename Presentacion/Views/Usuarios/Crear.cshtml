@model Aplicacion.DTOs.DTOSUsuario

@{
    ViewData["Title"] = "Nuevo Usuario";
    var roles = ViewBag.Roles as List<Aplicacion.DTOs.RolDT> ?? new List<Aplicacion.DTOs.RolDT>();
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad / Usuarios</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-user-plus me-2 text-primary"></i>Registrar Nuevo Usuario
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Volver a Usuarios
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="card-header bg-white py-3 border-bottom">
                <h3 class="card-title text-dark fw-bold m-0">
                    <i class="ti ti-user-shield me-2 text-primary"></i>Datos de la Cuenta
                </h3>
            </div>

            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombres" class="form-label required"></label>
                        <input asp-for="Nombres" class="form-control" placeholder="Nombres" autofocus />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellidos" class="form-label required"></label>
                        <input asp-for="Apellidos" class="form-control" placeholder="Apellidos" />
                        <span asp-validation-for="Apellidos" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Correo" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-mail"></i></span>
                            <input asp-for="Correo" type="email" class="form-control" placeholder="usuario@codestore.com" />
                        </div>
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefono" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-phone"></i></span>
                            <input asp-for="Telefono" class="form-control" placeholder="+505 8888-8888" />
                        </div>
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IdRol" class="form-label required"></label>
                        <select asp-for="IdRol" class="form-select">
                            <option value="">-- Seleccione un Rol --</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r.IdRol">@r.NombreRol (@r.CodigoRol)</option>
                            }
                        </select>
                        <span asp-validation-for="IdRol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Contraseña" class="form-label required"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-lock"></i></span>
                            <input asp-for="Contraseña" type="password" class="form-control" placeholder="Mínimo 6 caracteres" required />
                        </div>
                        <span asp-validation-for="Contraseña" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-check form-switch cursor-pointer">
                            <input asp-for="Activo" class="form-check-input" type="checkbox" checked />
                            <span class="form-check-label fw-medium">Cuenta Activa</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-link link-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary d-inline-flex align-items-center">
                    <i class="ti ti-device-floppy me-2 fs-3"></i> Guardar Usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

