@model IEnumerable<Aplicacion.DTOs.DTOsClientes>

@{
    ViewData["Title"] = "Directorio de Clientes";
    var totalClientes = Model.Count();
}

<!-- Page Header -->
<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Catálogos</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-users me-2 text-primary"></i>Directorio de Clientes
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-user-plus me-1 fs-3"></i> Nuevo Cliente
            </a>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-list me-2 text-primary"></i>Listado de Clientes
        </h3>
        <span class="badge bg-blue-lt">@totalClientes registrados</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaClientes" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="w-1">Identificación</th>
                        <th>Cliente</th>
                        <th>Contacto</th>
                        <th>Dirección</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-dark-lt font-monospace fs-5">@item.NumeroIdentificacion</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm me-2 bg-primary-lt">
                                        <i class="ti ti-user fs-3"></i>
                                    </span>
                                    <div>
                                        <div class="fw-semibold text-dark">@item.Nombres @item.Apellidos</div>
                                        <div class="text-secondary small">ID: #@item.IdCliente</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div>
                                    @if (!string.IsNullOrEmpty(item.Telefono))
                                    {
                                        <div class="small"><i class="ti ti-phone me-1 text-secondary"></i>@item.Telefono</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Correo))
                                    {
                                        <div class="small"><i class="ti ti-mail me-1 text-secondary"></i>@item.Correo</div>
                                    }
                                    @if (string.IsNullOrEmpty(item.Telefono) && string.IsNullOrEmpty(item.Correo))
                                    {
                                        <span class="text-secondary small">Sin contacto registrado</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary small">@(string.IsNullOrEmpty(item.Direccion) ? "No especificada" : item.Direccion)</span>
                            </td>
                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success-lt">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-lt">Inactivo</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Editar" asp-route-id="@item.IdCliente" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar-cliente" data-id="@item.IdCliente" data-nombre="@item.Nombres @item.Apellidos" title="Eliminar">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaClientes').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[1, 'asc']],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"])),
                    timer: 3500,
                    showConfirmButton: false
                });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]))
                });
                </text>
            }

            $(document).on('click', '.btn-eliminar-cliente', function () {
                const id = $(this).data('id');
                const nombre = $(this).data('nombre');

                Swal.fire({
                    title: '¿Eliminar cliente?',
                    text: `¿Estás seguro de que deseas eliminar a "${nombre}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d63939',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: '<i class="ti ti-trash me-1"></i> Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.post('@Url.Action("Eliminar", "Clientes")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Eliminado',
                                    text: res.message,
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'No se pudo eliminar',
                                    text: res.message
                                });
                            }
                        }).fail(function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Error en la solicitud de eliminación.'
                            });
                        });
                    }
                });
            });
        });
    </script>
}

