@model IEnumerable<Aplicacion.DTOs.DTOSVenta>

@{
    ViewData["Title"] = "Historial de Ventas";
    var clientesDict = ViewBag.Clientes as Dictionary<int, string> ?? new Dictionary<int, string>();
    var totalVentas = Model.Count();
    var montoTotal = Model.Where(v => v.Estado == "Completada").Sum(v => v.TotalVenta);
    var contado = Model.Count(v => v.TipoVenta == "Contado");
    var credito = Model.Count(v => v.TipoVenta == "Credito");
}

<!-- Page Header -->
<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Ventas & Facturación</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-receipt me-2 text-primary"></i>Historial de Ventas
            </h2>
            <div class="text-secondary mt-1">Registro cronológico de facturas, ventas al contado y financiamientos</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-cash me-1 fs-3"></i> Nueva Venta (POS)
            </a>
        </div>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row row-cards mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-primary-lt avatar avatar-md">
                            <i class="ti ti-receipt fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Total Facturas</div>
                        <div class="fs-2 fw-bold text-dark">@totalVentas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-success-lt avatar avatar-md">
                            <i class="ti ti-currency-dollar fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Ingresos Facturados</div>
                        <div class="fs-2 fw-bold text-success">C$ @montoTotal.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-azure-lt avatar avatar-md">
                            <i class="ti ti-cash fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Ventas Contado</div>
                        <div class="fs-2 fw-bold text-azure">@contado</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="bg-purple-lt avatar avatar-md">
                            <i class="ti ti-credit-card fs-2"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Ventas a Crédito</div>
                        <div class="fs-2 fw-bold text-purple">@credito</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-list me-2 text-primary"></i>Listado de Transacciones
        </h3>
        <span class="badge bg-blue-lt">@totalVentas registradas</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaVentas" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="w-1">Factura</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Tipo / Pago</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA (15%)</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var clienteNombre = clientesDict.ContainsKey(item.IdCliente) ? clientesDict[item.IdCliente] : $"Cliente #{item.IdCliente}";
                        <tr>
                            <td>
                                <span class="badge bg-dark-lt font-monospace fs-5">@item.NumeroFactura</span>
                            </td>
                            <td>
                                <div class="text-dark fw-medium">@item.FechaVenta.ToString("dd/MM/yyyy")</div>
                                <div class="text-secondary small">@item.FechaVenta.ToString("hh:mm tt")</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@clienteNombre</div>
                            </td>
                            <td>
                                <div>
                                    <span class="badge @(item.TipoVenta == "Contado" ? "bg-azure-lt" : "bg-purple-lt") me-1">
                                        @item.TipoVenta
                                    </span>
                                    <span class="text-secondary small">@item.MetodoPago</span>
                                </div>
                            </td>
                            <td class="text-end text-secondary">
                                C$ @item.Subtotal.ToString("N2")
                            </td>
                            <td class="text-end text-secondary">
                                C$ @item.Impuesto.ToString("N2")
                            </td>
                            <td class="text-end fw-bold text-success fs-4">
                                C$ @item.TotalVenta.ToString("N2")
                            </td>
                            <td class="text-center">
                                @if (item.Estado == "Completada")
                                {
                                    <span class="badge bg-success-lt">Completada</span>
                                }
                                else if (item.Estado == "Anulada")
                                {
                                    <span class="badge bg-danger-lt">Anulada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-lt">@item.Estado</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Detalle" asp-route-id="@item.IdVenta" class="btn btn-sm btn-outline-primary" title="Ver Factura Completa">
                                        <i class="ti ti-file-invoice me-1"></i> Ver
                                    </a>
                                    @if (item.Estado != "Anulada" && User.IsInRole("Administrador"))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-anular-venta" data-id="@item.IdVenta" data-fac="@item.NumeroFactura" title="Anular Factura">
                                            <i class="ti ti-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaVentas').DataTable({
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json'
                },
                order: [[1, 'desc']],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: '¡Operación Exitosa!',
                    text: '@Html.Raw(TempData["Success"])',
                    timer: 3500,
                    showConfirmButton: false
                });
                </text>
            }

            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Atención',
                    text: '@Html.Raw(TempData["Error"])'
                });
                </text>
            }

            $(document).on('click', '.btn-anular-venta', function () {
                const id = $(this).data('id');
                const fac = $(this).data('fac');

                Swal.fire({
                    title: `Anular Factura ${fac}`,
                    input: 'text',
                    inputLabel: 'Motivo de anulación',
                    inputPlaceholder: 'Ej: Devolución del cliente / Error en facturación',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d63939',
                    confirmButtonText: 'Confirmar Anulación',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (v) => {
                        if (!v || !v.trim()) return 'Debe ingresar el motivo de la anulación.';
                    }
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("Anular", "Ventas")', { id: id, motivo: r.value }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Anulada', text: res.message, timer: 2500, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            }
                        });
                    }
                });
            });
        });
    </script>
}

