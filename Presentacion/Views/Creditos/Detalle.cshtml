@model Aplicacion.DTOs.DTOSCredito

@{
    ViewData["Title"] = $"Crédito #{Model.IdCredito}";
    var venta = ViewBag.Venta as Dominio.Entidades.Venta;
    var cliente = ViewBag.Cliente as Aplicacion.DTOs.DTOsClientes;
    var cuotas = ViewBag.Cuotas as List<Aplicacion.DTOs.DTOSCuotaCredito> ?? new List<Aplicacion.DTOs.DTOSCuotaCredito>();
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Créditos & Cobranzas</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-list-details me-2 text-primary"></i>Plan de Pagos - Crédito #@Model.IdCredito
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Volver a Créditos
            </a>
        </div>
    </div>
</div>

<!-- Resumen del Crédito -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-secondary small">Cliente</div>
                <div class="fw-bold fs-3 text-dark">@(cliente != null ? $"{cliente.Nombres} {cliente.Apellidos}" : "Cliente N/D")</div>
                <div class="text-secondary small">Factura: <span class="font-monospace">@(venta?.NumeroFactura ?? $"#{Model.IdVenta}")</span></div>
            </div>
            <div class="col-md-2">
                <div class="text-secondary small">Total Venta</div>
                <div class="fw-semibold fs-3">C$ @Model.MontoVentaTotal.ToString("N2")</div>
                <div class="text-secondary small">Prima: C$ @Model.PrimaInicial.ToString("N2")</div>
            </div>
            <div class="col-md-2">
                <div class="text-secondary small">Total Financiado</div>
                <div class="fw-semibold fs-3">C$ @Model.MontoTotalCredito.ToString("N2")</div>
                <div class="text-secondary small">Interés: @Model.PorcentajeInteres%</div>
            </div>
            <div class="col-md-2">
                <div class="text-secondary small">Saldo Pendiente</div>
                <div class="fw-bold fs-2 @(Model.SaldoPendiente > 0 ? "text-danger" : "text-success")">C$ @Model.SaldoPendiente.ToString("N2")</div>
            </div>
            <div class="col-md-2 text-md-end">
                <div class="text-secondary small mb-1">Estado</div>
                <span class="badge @(Model.Estado == "Pagado" ? "bg-success-lt" : Model.Estado == "Anulado" ? "bg-danger-lt" : "bg-warning-lt") fs-4">@Model.Estado</span>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Cuotas -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-calendar me-2 text-primary"></i>Cuotas Programadas (@Model.FrecuenciaPago)
        </h3>
    </div>
    <div class="card-body p-3">
        <div class="table-responsive">
            <table class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="text-center w-1">#</th>
                        <th>Vencimiento</th>
                        <th class="text-end">Monto Cuota</th>
                        <th class="text-end">Mora</th>
                        <th class="text-end">Abonado</th>
                        <th class="text-end">Saldo Cuota</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in cuotas)
                    {
                        bool vencida = c.Estado != "Pagada" && c.Estado != "Anulada" && c.FechaVencimiento.Date < DateTime.Today;
                        <tr class="@(vencida ? "table-danger" : "")">
                            <td class="text-center fw-bold">@c.NumeroCuota</td>
                            <td>
                                @c.FechaVencimiento.ToString("dd/MM/yyyy")
                                @if (vencida)
                                {
                                    <span class="badge bg-danger text-white ms-1">Vencida</span>
                                }
                            </td>
                            <td class="text-end">C$ @c.MontoCuota.ToString("N2")</td>
                            <td class="text-end text-danger">C$ @c.RecargoMora.ToString("N2")</td>
                            <td class="text-end text-success">C$ @c.MontoAbonado.ToString("N2")</td>
                            <td class="text-end fw-bold">C$ @c.SaldoCuota.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge @(c.Estado == "Pagada" ? "bg-success-lt" : c.Estado == "Parcial" ? "bg-azure-lt" : c.Estado == "Anulada" ? "bg-danger-lt" : "bg-warning-lt")">
                                    @c.Estado
                                </span>
                            </td>
                            <td class="text-center text-nowrap">
                                @if (c.Estado != "Pagada" && c.Estado != "Anulada")
                                {
                                    <div class="btn-group">
                                        <a asp-controller="Abonos" asp-action="Crear" asp-route-idCuota="@c.IdCuota" class="btn btn-sm btn-success">
                                            <i class="ti ti-coin me-1"></i> Abonar
                                        </a>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-warning btn-aplicar-mora"
                                                    data-id="@c.IdCuota"
                                                    data-num="@c.NumeroCuota"
                                                    data-mora="@c.RecargoMora.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    title="Aplicar / Editar Mora">
                                                <i class="ti ti-alert-circle"></i>
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-aplicar-mora').on('click', function () {
                const id = $(this).data('id');
                const num = $(this).data('num');
                const moraActual = $(this).data('mora');

                Swal.fire({
                    title: `Recargo por Mora - Cuota #${num}`,
                    input: 'number',
                    inputLabel: 'Monto de mora (C$)',
                    inputValue: moraActual,
                    inputAttributes: { min: '0', step: '0.01' },
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f59f00',
                    confirmButtonText: 'Guardar Mora',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (v) => {
                        if (v === '' || parseFloat(v) < 0 || isNaN(parseFloat(v))) {
                            return 'Ingrese un monto válido mayor o igual a cero.';
                        }
                    }
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("AplicarMora", "Creditos")', { idCuota: id, recargoMora: r.value }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Mora Actualizada', text: res.message, timer: 2000, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'No se pudo aplicar', text: res.message });
                            }
                        }).fail(function () {
                            Swal.fire({ icon: 'error', title: 'Error de conexión', text: 'No se pudo completar la solicitud. Intente nuevamente.' });
                        });
                    }
                });
            });
        });
    </script>
}

