@model Aplicacion.DTOs.CompraRegistroDTO

@{
    ViewData["Title"] = "Registrar Compra";
    var proveedores = ViewBag.Proveedores as List<Aplicacion.DTOs.DTOProveedor> ?? new List<Aplicacion.DTOs.DTOProveedor>();
    var productos = ViewBag.Productos as List<Aplicacion.DTOs.DTOSProductos> ?? new List<Aplicacion.DTOs.DTOSProductos>();
}

<div class="page-header d-print-none mb-3">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Compras & Abastecimiento</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-package-import me-2 text-primary"></i>Registrar Compra / Abastecimiento
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Historial de Compras
            </a>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Columna Izquierda -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label required small fw-bold">Proveedor</label>
                        <select id="selectProveedor" class="form-select">
                            <option value="">-- Seleccione un Proveedor --</option>
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.IdProveedor">@p.RazonSocial (RUC: @p.NumeroRUC)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small fw-bold">N° Factura / Documento Proveedor</label>
                        <input type="text" id="inputNumeroDoc" class="form-control" placeholder="Opcional (se autogenera si está vacío)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Buscador de productos -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white py-2 border-bottom">
                <h4 class="card-title text-dark fw-bold m-0 fs-4">
                    <i class="ti ti-search me-2 text-primary"></i>Agregar Productos a la Compra
                </h4>
            </div>
            <div class="card-body p-3">
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="ti ti-barcode"></i></span>
                    <input type="text" id="inputBuscarProdCompra" class="form-control" placeholder="Buscar por SKU, Nombre o Marca..." />
                </div>

                <div class="table-responsive" style="max-height: 220px; overflow-y: auto;">
                    <table class="table table-sm table-hover align-middle" id="tablaProdCompra">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>SKU</th>
                                <th>Producto</th>
                                <th class="text-center">Stock Actual</th>
                                <th class="text-end">Últ. Costo</th>
                                <th class="text-center w-1">Agregar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in productos)
                            {
                                <tr data-id="@prod.IdProducto" data-sku="@prod.CodigoSKU" data-nombre="@prod.Nombre" data-costo="@((prod.UltimoCostoCompra > 0 ? prod.UltimoCostoCompra : prod.PrecioVenta * 0.7m).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                    <td><span class="badge bg-dark-lt font-monospace">@prod.CodigoSKU</span></td>
                                    <td>
                                        <div class="fw-semibold">@prod.Nombre</div>
                                        <div class="text-secondary small">@prod.Marca @prod.Modelo</div>
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary-lt">@prod.StockActual uds</span></td>
                                    <td class="text-end text-secondary">C$ @prod.UltimoCostoCompra.ToString("N2")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-primary btn-agregar-compra"><i class="ti ti-plus"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Detalle de Compra -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-2 border-bottom">
                <h4 class="card-title text-dark fw-bold m-0 fs-4">
                    <i class="ti ti-list-details me-2 text-primary"></i>Detalle de Productos a Comprar
                </h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th class="text-center" style="width: 120px;">Cantidad</th>
                                <th class="text-end" style="width: 150px;">Costo Unit. (C$)</th>
                                <th class="text-end" style="width: 130px;">Subtotal</th>
                                <th class="w-1"></th>
                            </tr>
                        </thead>
                        <tbody id="detalleCompraBody">
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">
                                    Agregue productos de la tabla superior para armar la orden de compra.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Columna Derecha: Resumen -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
            <div class="card-header bg-primary text-white py-3">
                <h3 class="card-title fw-bold m-0 text-white">
                    <i class="ti ti-calculator me-2"></i>Resumen de Compra
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-3 align-items-center">
                    <span class="fs-3 fw-bold text-dark">Total Compra:</span>
                    <span class="fs-1 fw-bold text-primary" id="totalCompraTexto">C$ 0.00</span>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch cursor-pointer">
                        <input type="checkbox" id="chkRecibirInmediato" class="form-check-input" checked />
                        <span class="form-check-label fw-semibold">Recibir mercadería inmediatamente</span>
                    </label>
                    <div class="text-secondary small ms-5">
                        Si está activo, aumentará el stock, recalculará el costo promedio y registrará el Kardex de inmediato. Si lo desactivas, quedará como orden <strong>Pendiente</strong>.
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small">Observaciones</label>
                    <textarea id="inputObsCompra" rows="3" class="form-control" placeholder="Notas de entrega, número de guía, etc."></textarea>
                </div>

                <button type="button" id="btnGuardarCompra" class="btn btn-primary w-100 py-3 fs-3 fw-bold">
                    <i class="ti ti-device-floppy me-2"></i> Registrar Compra
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let itemsCompra = [];

        $(document).ready(function () {
            $('#inputBuscarProdCompra').on('keyup', function () {
                const v = $(this).val().toLowerCase();
                $('#tablaProdCompra tbody tr').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(v) > -1);
                });
            });

            $('.btn-agregar-compra').on('click', function () {
                const tr = $(this).closest('tr');
                const id = parseInt(tr.data('id'));
                const sku = tr.data('sku');
                const nombre = tr.data('nombre');
                const costo = parseFloat(tr.data('costo')) || 0;

                const ex = itemsCompra.find(x => x.idProducto === id);
                if (ex) {
                    ex.cantidad += 1;
                } else {
                    itemsCompra.push({
                        idProducto: id,
                        sku: sku,
                        nombre: nombre,
                        cantidad: 1,
                        costoUnitario: costo > 0 ? parseFloat(costo.toFixed(2)) : 1.00
                    });
                }
                renderCompra();
            });

            $('#btnGuardarCompra').on('click', function () {
                guardarCompra();
            });
        });

        function renderCompra() {
            const tbody = $('#detalleCompraBody');
            tbody.empty();

            if (itemsCompra.length === 0) {
                tbody.html('<tr><td colspan="5" class="text-center py-4 text-secondary">Agregue productos de la tabla superior para armar la orden de compra.</td></tr>');
                $('#totalCompraTexto').text('C$ 0.00');
                return;
            }

            let total = 0;
            itemsCompra.forEach((item, idx) => {
                const sub = item.cantidad * item.costoUnitario;
                total += sub;

                tbody.append(`
                    <tr>
                        <td>
                            <div class="fw-semibold text-dark">${item.nombre}</div>
                            <div class="text-secondary small font-monospace">${item.sku}</div>
                        </td>
                        <td>
                            <input type="number" min="1" class="form-control form-control-sm text-center inp-cant" data-idx="${idx}" value="${item.cantidad}" />
                        </td>
                        <td>
                            <input type="number" min="0.01" step="0.01" class="form-control form-control-sm text-end inp-costo" data-idx="${idx}" value="${item.costoUnitario}" />
                        </td>
                        <td class="text-end fw-bold">C$ ${sub.toFixed(2)}</td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-del-item" data-idx="${idx}">
                                <i class="ti ti-trash fs-3"></i>
                            </button>
                        </td>
                    </tr>
                `);
            });

            $('#totalCompraTexto').text('C$ ' + total.toLocaleString('es-NI', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            $('.inp-cant').on('change', function () {
                const idx = $(this).data('idx');
                itemsCompra[idx].cantidad = Math.max(1, parseInt($(this).val()) || 1);
                renderCompra();
            });

            $('.inp-costo').on('change', function () {
                const idx = $(this).data('idx');
                itemsCompra[idx].costoUnitario = Math.max(0.01, parseFloat($(this).val()) || 0.01);
                renderCompra();
            });

            $('.btn-del-item').on('click', function () {
                itemsCompra.splice($(this).data('idx'), 1);
                renderCompra();
            });
        }

        function guardarCompra() {
            const idProv = parseInt($('#selectProveedor').val());
            if (!idProv) {
                Swal.fire({ icon: 'warning', title: 'Atención', text: 'Seleccione un proveedor.' });
                return;
            }
            if (itemsCompra.length === 0) {
                Swal.fire({ icon: 'warning', title: 'Sin productos', text: 'Agregue al menos un producto a la compra.' });
                return;
            }

            const payload = {
                idProveedor: idProv,
                numeroDocumento: $('#inputNumeroDoc').val(),
                observaciones: $('#inputObsCompra').val(),
                recibirInmediatamente: $('#chkRecibirInmediato').is(':checked'),
                items: itemsCompra.map(i => ({
                    idProducto: i.idProducto,
                    cantidad: i.cantidad,
                    costoUnitario: i.costoUnitario
                }))
            };

            Swal.fire({
                title: 'Procesando compra...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });

            $.ajax({
                url: '@Url.Action("RegistrarCompra", "Compras")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Compra Registrada!',
                            html: `Documento: <strong class="badge bg-dark-lt fs-4">${res.numeroDocumento}</strong><br>${res.message}`,
                            confirmButtonText: 'Ver Detalle'
                        }).then(() => {
                            window.location.href = '@Url.Action("Detalle", "Compras")/' + res.idCompra;
                        });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al registrar la compra.' });
                }
            });
        }
    </script>
}

