@model IEnumerable<Aplicacion.DTOs.DTOSCompra>

@{
    ViewData["Title"] = "Historial de Compras";
    var proveedoresDict = ViewBag.Proveedores as Dictionary<int, string> ?? new Dictionary<int, string>();
    var totalCompras = Model.Count();
    var recibidas = Model.Count(c => c.Estado == "Recibida");
    var pendientes = Model.Count(c => c.Estado == "Pendiente");
    var montoTotal = Model.Where(c => c.Estado == "Recibida").Sum(c => c.TotalCompra);
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Compras & Abastecimiento</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-truck-delivery me-2 text-primary"></i>Historial de Compras
            </h2>
            <div class="text-secondary mt-1">Control de órdenes de compra, recepciones de mercadería y costos de reposición</div>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Crear" class="btn btn-primary d-inline-flex align-items-center">
                <i class="ti ti-plus me-1 fs-3"></i> Registrar Compra
            </a>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row row-cards mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-primary-lt avatar avatar-md"><i class="ti ti-file-invoice fs-2"></i></span></div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Total Compras</div>
                        <div class="fs-2 fw-bold text-dark">@totalCompras</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-success-lt avatar avatar-md"><i class="ti ti-check fs-2"></i></span></div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Recibidas</div>
                        <div class="fs-2 fw-bold text-success">@recibidas</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-warning-lt avatar avatar-md"><i class="ti ti-clock fs-2"></i></span></div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Pendientes</div>
                        <div class="fs-2 fw-bold text-warning">@pendientes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto"><span class="bg-azure-lt avatar avatar-md"><i class="ti ti-currency-dollar fs-2"></i></span></div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Inversión Recibida</div>
                        <div class="fs-2 fw-bold text-azure">C$ @montoTotal.ToString("N2")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
        <h3 class="card-title fw-bold text-dark m-0">
            <i class="ti ti-list me-2 text-primary"></i>Órdenes de Compra
        </h3>
        <span class="badge bg-blue-lt">@totalCompras registradas</span>
    </div>

    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="tablaCompras" class="table table-vcenter table-hover card-table">
                <thead>
                    <tr>
                        <th class="w-1">Documento</th>
                        <th>Fecha</th>
                        <th>Proveedor</th>
                        <th class="text-end">Total Compra</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center w-1">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var provNombre = proveedoresDict.ContainsKey(item.IdProveedor) ? proveedoresDict[item.IdProveedor] : $"Proveedor #{item.IdProveedor}";
                        <tr>
                            <td><span class="badge bg-dark-lt font-monospace fs-5">@item.NumeroDocumento</span></td>
                            <td>
                                <div class="text-dark fw-medium">@item.FechaCompra.ToString("dd/MM/yyyy")</div>
                                <div class="text-secondary small">@item.FechaCompra.ToString("hh:mm tt")</div>
                            </td>
                            <td><div class="fw-semibold text-dark">@provNombre</div></td>
                            <td class="text-end fw-bold text-dark fs-4">C$ @item.TotalCompra.ToString("N2")</td>
                            <td class="text-center">
                                @if (item.Estado == "Recibida")
                                {
                                    <span class="badge bg-success-lt">Recibida</span>
                                }
                                else if (item.Estado == "Pendiente")
                                {
                                    <span class="badge bg-warning-lt">Pendiente</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-lt">Anulada</span>
                                }
                            </td>
                            <td class="text-center text-nowrap">
                                <div class="btn-group">
                                    <a asp-action="Detalle" asp-route-id="@item.IdCompra" class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    @if (item.Estado == "Pendiente")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success btn-recibir-compra" data-id="@item.IdCompra" data-doc="@item.NumeroDocumento" title="Confirmar Recepción">
                                            <i class="ti ti-package-import"></i>
                                        </button>
                                    }
                                    @if (item.Estado != "Anulada")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-anular-compra" data-id="@item.IdCompra" data-doc="@item.NumeroDocumento" title="Anular Compra">
                                            <i class="ti ti-ban"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaCompras').DataTable({
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json' },
                order: [[1, 'desc']],
                pageLength: 10,
                responsive: true
            });

            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({ icon: 'success', title: '¡Éxito!', text: '@Html.Raw(TempData["Success"])', timer: 3000, showConfirmButton: false });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({ icon: 'error', title: 'Atención', text: '@Html.Raw(TempData["Error"])' });
                </text>
            }

            $(document).on('click', '.btn-recibir-compra', function () {
                const id = $(this).data('id');
                const doc = $(this).data('doc');

                Swal.fire({
                    title: '¿Confirmar recepción?',
                    text: `Se ingresará el stock de la compra "${doc}" al inventario y se registrará en Kardex.`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#2fb344',
                    confirmButtonText: 'Sí, recibir mercadería',
                    cancelButtonText: 'Cancelar'
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("ConfirmarRecepcion", "Compras")', { id: id }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Recibida', text: res.message, timer: 2000, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            }
                        });
                    }
                });
            });

            $(document).on('click', '.btn-anular-compra', function () {
                const id = $(this).data('id');
                const doc = $(this).data('doc');

                Swal.fire({
                    title: `Anular Compra ${doc}`,
                    input: 'text',
                    inputLabel: 'Motivo de la anulación',
                    inputPlaceholder: 'Ej: Error de digitación / Devolución a proveedor',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d63939',
                    confirmButtonText: 'Confirmar Anulación',
                    cancelButtonText: 'Cancelar',
                    inputValidator: (value) => {
                        if (!value || !value.trim()) return 'Debe indicar un motivo para anular.';
                    }
                }).then((r) => {
                    if (r.isConfirmed) {
                        $.post('@Url.Action("Anular", "Compras")', { id: id, motivo: r.value }, function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Anulada', text: res.message, timer: 2000, showConfirmButton: false }).then(() => location.reload());
                            } else {
                                Swal.fire({ icon: 'error', title: 'No se pudo anular', text: res.message });
                            }
                        });
                    }
                });
            });
        });
    </script>
}

