@model Aplicacion.DTOs.RolDT

@{
    ViewData["Title"] = "Nuevo Rol";
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Seguridad / Roles</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-plus me-2 text-primary"></i>Registrar Nuevo Rol
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Volver a Roles
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="card-header bg-white py-3 border-bottom">
                <h3 class="card-title text-dark fw-bold m-0">
                    <i class="ti ti-shield-lock me-2 text-primary"></i>Información del Rol
                </h3>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="CodigoRol" class="form-label required"></label>
                        <input asp-for="CodigoRol" class="form-control" placeholder="Ej: Rol-01" autofocus />
                        <span asp-validation-for="CodigoRol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="NombreRol" class="form-label required"></label>
                        <input asp-for="NombreRol" class="form-control" placeholder="Ej: Administrador, Vendedor, Técnico" />
                        <span asp-validation-for="NombreRol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Descripcion" class="form-label required"></label>
                        <textarea asp-for="Descripcion" rows="2" class="form-control" placeholder="Permisos y alcance de este rol..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-check form-switch cursor-pointer">
                            <input asp-for="Activo" class="form-check-input" type="checkbox" checked />
                            <span class="form-check-label fw-medium">Rol Activo</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light py-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-link link-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary d-inline-flex align-items-center">
                    <i class="ti ti-device-floppy me-2 fs-3"></i> Guardar Rol
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

