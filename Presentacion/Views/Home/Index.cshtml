@model Presentacion.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard Principal";
}

<!-- Page Header -->
<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle text-secondary">
                Panel de Control
            </div>
            <h2 class="page-title text-dark fw-bold">
                Resumen General de Operaciones
            </h2>
        </div>
        <!-- Quick Action Buttons -->
        <div class="col-auto ms-auto d-print-none">
            <div class="btn-list">
                @if (User.IsInRole("Administrador") || User.IsInRole("Vendedor"))
                {
                    <a asp-controller="Ventas" asp-action="Crear" class="btn btn-primary d-none d-sm-inline-block">
                        <i class="ti ti-shopping-cart-plus me-1"></i> Nueva Venta
                    </a>
                }
                @if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
                {
                    <a asp-controller="OrdenReparacion" asp-action="Crear" class="btn btn-outline-primary d-none d-sm-inline-block">
                        <i class="ti ti-tools me-1"></i> Ingreso a Taller
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Stat Cards -->
<div class="row row-deck row-cards mb-4">
    <!-- Ventas del Mes -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar avatar-md bg-primary-lt text-primary rounded-3">
                            <i class="ti ti-cash fs-1"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Ventas del Mes</div>
                        <div class="fs-2 fw-bold text-dark mt-1">C$ @Model.VentasDelMes.ToString("N2")</div>
                        <div class="text-success small mt-1 d-flex align-items-center">
                            <i class="ti ti-receipt me-1"></i> @Model.CantidadVentasMes facturas completadas
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Clientes Activos -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar avatar-md bg-success-lt text-success rounded-3">
                            <i class="ti ti-users fs-1"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Clientes Activos</div>
                        <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalClientesActivos</div>
                        <div class="text-secondary small mt-1 d-flex align-items-center">
                            <i class="ti ti-credit-card me-1"></i> Cartera: C$ @Model.CarteraCreditosPendiente.ToString("N2")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipos en Taller -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar avatar-md bg-warning-lt text-warning rounded-3">
                            <i class="ti ti-cpu fs-1"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Equipos en Taller</div>
                        <div class="fs-2 fw-bold text-dark mt-1">@Model.EquiposEnTaller</div>
                        <div class="text-warning small mt-1 d-flex align-items-center">
                            <i class="ti ti-tools me-1"></i> Órdenes en proceso
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stock Bajo -->
    <div class="col-sm-6 col-lg-3">
        <div class="card card-hover card-sm border-0 shadow-sm">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="avatar avatar-md bg-danger-lt text-danger rounded-3">
                            <i class="ti ti-alert-triangle fs-1"></i>
                        </span>
                    </div>
                    <div class="col">
                        <div class="text-secondary small fw-medium">Stock Bajo / Crítico</div>
                        <div class="fs-2 fw-bold text-danger mt-1">@Model.ProductosStockBajo</div>
                        <div class="text-danger small mt-1 d-flex align-items-center">
                            <i class="ti ti-package me-1"></i> Requieren reposición
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tablas Resumen -->
<div class="row row-cards">
    <!-- Últimas Ventas -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h3 class="card-title fw-bold text-dark m-0">
                    <i class="ti ti-receipt me-2 text-primary"></i>Últimas Ventas Registradas
                </h3>
                <a asp-controller="Ventas" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver Todas</a>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Cliente</th>
                            <th>Tipo</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.UltimasVentas.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">Aún no hay ventas registradas.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var v in Model.UltimasVentas)
                            {
                                var cli = Model.ClientesNombres.ContainsKey(v.IdCliente) ? Model.ClientesNombres[v.IdCliente] : $"Cliente #{v.IdCliente}";
                                <tr>
                                    <td><a asp-controller="Ventas" asp-action="Detalle" asp-route-id="@v.IdVenta" class="badge bg-dark-lt font-monospace text-decoration-none">@v.NumeroFactura</a></td>
                                    <td class="fw-medium">@cli</td>
                                    <td><span class="badge @(v.TipoVenta == "Contado" ? "bg-azure-lt" : "bg-purple-lt")">@v.TipoVenta</span></td>
                                    <td class="text-end fw-bold text-success">C$ @v.TotalVenta.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge @(v.Estado == "Completada" ? "bg-success-lt" : "bg-danger-lt")">@v.Estado</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Alertas de Stock Crítico -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h3 class="card-title fw-bold text-dark m-0">
                    <i class="ti ti-alert-triangle me-2 text-danger"></i>Alertas de Stock Bajo
                </h3>
                @if (User.IsInRole("Administrador"))
                {
                    <a asp-controller="Compras" asp-action="Crear" class="btn btn-sm btn-outline-danger">Abastecer</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">Actual</th>
                            <th class="text-center">Mínimo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.ProductosCriticos.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-success">
                                    <i class="ti ti-check me-1"></i> Todo el inventario está en niveles saludables.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Model.ProductosCriticos)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@p.Nombre</div>
                                        <div class="text-secondary small font-monospace">@p.CodigoSKU</div>
                                    </td>
                                    <td class="text-center"><span class="badge bg-danger text-white">@p.StockActual</span></td>
                                    <td class="text-center text-secondary">@p.StockMinimo</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Órdenes de Reparación Recientes -->
<div class="row row-cards mt-3">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h3 class="card-title fw-bold text-dark m-0">
                    <i class="ti ti-tools me-2 text-warning"></i>Órdenes de Taller Recientes
                </h3>
                @if (User.IsInRole("Administrador") || User.IsInRole("Tecnico"))
                {
                    <a asp-controller="OrdenReparacion" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver Taller</a>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th>Orden</th>
                            <th>Cliente</th>
                            <th>Equipo</th>
                            <th>Ingreso</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.OrdenesRecientes.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-secondary">No hay órdenes de reparación registradas.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var o in Model.OrdenesRecientes)
                            {
                                var cli = Model.ClientesNombres.ContainsKey(o.IdCliente) ? Model.ClientesNombres[o.IdCliente] : $"Cliente #{o.IdCliente}";
                                <tr>
                                    <td><span class="badge bg-dark-lt font-monospace">@o.NumeroOrden</span></td>
                                    <td class="fw-medium">@cli</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@o.DescripcionEquipo</div>
                                        <div class="text-secondary small">@o.Marca @o.Modelo</div>
                                    </td>
                                    <td class="text-secondary small">@o.FechaIngreso.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge @(o.EstadoEquipo == "Entregado" ? "bg-success-lt" : o.EstadoEquipo == "Reparado" ? "bg-azure-lt" : o.EstadoEquipo == "Sin Solucion" ? "bg-danger-lt" : "bg-warning-lt")">
                                            @o.EstadoEquipo
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Administrador"))
{
    <div class="modal modal-blur fade" id="modalTerminos" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="ti ti-file-text me-2 text-primary"></i>Términos y Condiciones de CodeStore
                    </h5>
                </div>
                <div class="modal-body text-secondary">
                    <p class="mb-2">
                        Bienvenido a <strong>CodeStore</strong>. Antes de comenzar a operar el sistema, te invitamos a revisar las condiciones de licencia, uso, soporte y respaldo de datos.
                    </p>
                    <p class="mb-0 small">
                        Al continuar, confirmás que leíste y aceptás los términos aplicables al uso del software.
                    </p>
                </div>
                <div class="modal-footer justify-content-between">
                    <a asp-controller="Home" asp-action="Terminos" target="_blank" class="btn btn-outline-primary">
                        <i class="ti ti-external-link me-1"></i> Leer Términos
                    </a>
                    <button type="button" id="btnAceptarTerminos" class="btn btn-primary">
                        <i class="ti ti-check me-1"></i> Aceptar y Continuar
                    </button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                const clave = 'codestore_terminos_aceptados';
                if (!localStorage.getItem(clave)) {
                    const modalEl = document.getElementById('modalTerminos');
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();

                    $('#btnAceptarTerminos').on('click', function () {
                        localStorage.setItem(clave, '1');
                        modal.hide();
                    });
                }
            });
        </script>
    }
}
