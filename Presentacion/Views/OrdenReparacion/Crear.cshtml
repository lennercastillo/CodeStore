@model Aplicacion.DTOs.DTOSOrdenReparacion

@{
    ViewData["Title"] = "Nueva Orden de Reparación";
    var clientes = ViewBag.Clientes as List<Aplicacion.DTOs.DTOsClientes> ?? new List<Aplicacion.DTOs.DTOsClientes>();
    var tecnicos = ViewBag.Tecnicos as List<Aplicacion.DTOs.DTOSUsuario> ?? new List<Aplicacion.DTOs.DTOSUsuario>();
    var garantias = ViewBag.Garantias as List<Aplicacion.DTOs.DTOSReclamoGarantia> ?? new List<Aplicacion.DTOs.DTOSReclamoGarantia>();
}

<div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="page-pretitle">Taller Técnico</div>
            <h2 class="page-title text-dark">
                <i class="ti ti-tools me-2 text-primary"></i>Ingreso de Equipo a Taller
            </h2>
        </div>
        <div class="col-auto ms-auto d-print-none">
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <form asp-action="Crear" method="post" class="card border-0 shadow-sm">
            @Html.AntiForgeryToken()

            <div class="card-header bg-white py-3 border-bottom">
                <h3 class="card-title text-dark fw-bold m-0">Datos de Recepción del Equipo</h3>
            </div>

            <div class="card-body">
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mb-3">@TempData["Error"]</div>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="NumeroOrden" class="form-label required"></label>
                        <input asp-for="NumeroOrden" class="form-control font-monospace" />
                        <span asp-validation-for="NumeroOrden" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IdCliente" class="form-label required"></label>
                        <select asp-for="IdCliente" class="form-select">
                            <option value="">-- Seleccione Cliente --</option>
                            @foreach (var c in clientes)
                            {
                                <option value="@c.IdCliente">@c.Nombres @c.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="IdCliente" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IdUsuarioTecnico" class="form-label required"></label>
                        <select asp-for="IdUsuarioTecnico" class="form-select">
                            @foreach (var t in tecnicos)
                            {
                                <option value="@t.IdUsuario">@t.Nombres @t.Apellidos</option>
                            }
                        </select>
                        <span asp-validation-for="IdUsuarioTecnico" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="DescripcionEquipo" class="form-label required"></label>
                        <input asp-for="DescripcionEquipo" class="form-control" placeholder="Ej: Laptop Gamer no enciende / Pantalla quebrada" />
                        <span asp-validation-for="DescripcionEquipo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Marca" class="form-label required"></label>
                        <input asp-for="Marca" class="form-control" placeholder="Ej: HP, Lenovo, Apple" />
                        <span asp-validation-for="Marca" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Modelo" class="form-label required"></label>
                        <input asp-for="Modelo" class="form-control" placeholder="Ej: Pavilion 15" />
                        <span asp-validation-for="Modelo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NumeroSerie" class="form-label required"></label>
                        <input asp-for="NumeroSerie" class="form-control font-monospace" placeholder="S/N del equipo" />
                        <span asp-validation-for="NumeroSerie" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="EstadoEquipo" class="form-label required"></label>
                        <select asp-for="EstadoEquipo" class="form-select">
                            <option value="Recibido">Recibido</option>
                            <option value="En Diagnostico">En Diagnóstico</option>
                            <option value="En Reparacion">En Reparación</option>
                            <option value="Esperando Repuesto">Esperando Repuesto</option>
                            <option value="Reparado">Reparado</option>
                            <option value="Entregado">Entregado</option>
                            <option value="Sin Solucion">Sin Solución</option>
                        </select>
                        <span asp-validation-for="EstadoEquipo" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CostoReparacion" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="CostoReparacion" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="CostoReparacion" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IdGarantia" class="form-label">Reclamo de Garantía (Opcional)</label>
                        <select asp-for="IdGarantia" class="form-select">
                            <option value="">-- Sin garantía asociada --</option>
                            @foreach (var g in garantias)
                            {
                                <option value="@g.IdGarantia">@g.NumeroReclamo (@g.EstadoRevision)</option>
                            }
                        </select>
                        <span asp-validation-for="IdGarantia" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="DiagnosticoTecnico" class="form-label"></label>
                        <textarea asp-for="DiagnosticoTecnico" rows="2" class="form-control" placeholder="Diagnóstico inicial o falla reportada..."></textarea>
                        <span asp-validation-for="DiagnosticoTecnico" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Observaciones" class="form-label"></label>
                        <textarea asp-for="Observaciones" rows="2" class="form-control" placeholder="Accesorios incluidos (cargador, funda), rayones previos..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light py-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-link link-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-2"></i>Guardar Orden</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

